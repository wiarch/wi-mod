{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "Capacidad por defecto de la ventana principal",
  "windows": ["main", "splashscreen"],
  "permissions": [
    "core:default",
    "core:window:allow-show",
    "core:window:allow-close",
    "core:window:allow-set-focus",
    "sql:default",
    "sql:allow-execute",
    "allow-fetch-external-api",
    "allow-destroy-splashscreen"
  ]
}
