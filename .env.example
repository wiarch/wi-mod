# Modelo local alternativo vía Ollama
# Copia este archivo a .env y ajusta los valores. No subas .env al repositorio.

# Proveedor de IA: ollama (local) u otro
AI_PROVIDER=ollama

# URL base del servidor Ollama
OLLAMA_BASE_URL=http://localhost:11434

# Modelo descargado con `ollama pull <modelo>`
OLLAMA_MODEL=qwen2.5-coder:7b

# Tamaño de contexto en tokens (menos contexto = menos memoria y más velocidad)
OLLAMA_NUM_CTX=8192

# Tiempo máximo de espera por respuesta, en segundos
OLLAMA_TIMEOUT=120

# Ollama local no usa clave de API. Déjala vacía.
OLLAMA_API_KEY=
